// ================================================================
// INA219 DRIVER
// ================================================================

void inaWrite(uint8_t a,uint8_t r,uint16_t v){
  Wire.beginTransmission(a);
  Wire.write(r);
  Wire.write((uint8_t)(v>>8));
  Wire.write((uint8_t)(v&0xFF));
  Wire.endTransmission();
}

uint16_t inaRead(uint8_t a,uint8_t r){
  Wire.beginTransmission(a);
  Wire.write(r);
  if(Wire.endTransmission(false)!=0)return 0;
  Wire.requestFrom(a,(uint8_t)2);
  if(Wire.available()<2)return 0;
  uint16_t v=(uint16_t)Wire.read()<<8;
  v|=Wire.read();
  return v;
}

bool inaInit(InaDev &d){
  Wire.beginTransmission(d.addr);
  if(Wire.endTransmission()!=0){
    Serial.printf("[INA-%s] NOT FOUND\n",d.tag);
    return false;
  }

  inaWrite(d.addr,0x00,0x8000);
  delay(10);
  inaWrite(d.addr,0x00,0x3FFF);
  inaWrite(d.addr,0x05,d.cal);

  if(inaRead(d.addr,0x05)!=d.cal){
    Serial.printf("[INA-%s] CAL FAIL\n",d.tag);
    return false;
  }

  Serial.printf("[INA-%s] 0x%02X OK CAL=%u\n",
                d.tag,d.addr,d.cal);
  return true;
}

bool inaCheck(InaDev &d){
  return (inaRead(d.addr,0x00)==0x3FFF)||inaInit(d);
}

float inaVoltage(uint8_t a){
  return (float)(inaRead(a,0x02)>>3)*0.004f;
}

float inaCurrent(InaDev &d){
  float i=(float)(int16_t)inaRead(d.addr,0x04)*d.curLsb;
  return i<0?0:i;
}

float inaPower(InaDev &d){
  return (float)inaRead(d.addr,0x03)*d.pwrLsb;
}

// ================================================================
// VOLTAGE MEASUREMENTS
// ================================================================

float readSCVoltage(){
  uint32_t s=0;

  for(int i=0;i<OVS_SAMPLES;i++){
    s+=analogReadMilliVolts(PIN_SC_ADC);
    delayMicroseconds(100);
  }

  float adcV=(float)s/(float)OVS_SAMPLES/1000.0f;
  float rawV=adcV*DIV_K_SC;

  static float ema=0;

  if(ema==0)ema=rawV;
  else ema=0.85f*ema+0.15f*rawV;

  return ema;
}

float readLoadVoltage(){
  uint32_t s=0;

  for(int i=0;i<OVS_SAMPLES;i++){
    s+=analogReadMilliVolts(PIN_LOAD_ADC);
    delayMicroseconds(100);
  }

  float adcV=(float)s/(float)OVS_SAMPLES/1000.0f;
  float rawV=adcV*DIV_K_LOAD;

  static float ema=0;

  if(ema==0)ema=rawV;
  else ema=0.85f*ema+0.15f*rawV;

  return ema;
}

// ================================================================
// BATTERY VOLTAGE
// GPIO32 = CELL 1
// GPIO33 = TOTAL 2S PACK
// CELL 2 = PACK - CELL 1
// ================================================================

float readBatteryADC(uint8_t pin){
  uint32_t sum=0;

  for(int i=0;i<BAT_SAMPLES;i++){
    sum+=analogReadMilliVolts(pin);
    delayMicroseconds(100);
  }

  float adcV=(float)sum/(float)BAT_SAMPLES/1000.0f;
  return adcV*BAT_DIV_K;
}

int batteryPercent(float v){
  const float V[]={3.00f,3.30f,3.50f,3.60f,3.70f,
                   3.80f,3.90f,4.00f,4.10f,4.20f};

  const int P[]={0,5,10,20,40,55,70,82,92,100};

  if(v<=V[0])return 0;
  if(v>=V[9])return 100;

  for(int i=0;i<9;i++){
    if(v>=V[i]&&v<V[i+1]){
      float ratio=(v-V[i])/(V[i+1]-V[i]);
      return (int)(P[i]+ratio*(P[i+1]-P[i]));
    }
  }

  return 0;
}

void updateBattery(){
  batCell1=readBatteryADC(PIN_BAT1);
  batPack=readBatteryADC(PIN_BATPACK);

  batCell2=batPack-batCell1;

  if(batCell1<0)batCell1=0;
  if(batCell2<0)batCell2=0;

  bat1Percent=batteryPercent(batCell1);
  bat2Percent=batteryPercent(batCell2);

  batteryLow=(bat1Percent<=BAT_LOW_PERCENT||
              bat2Percent<=BAT_LOW_PERCENT);

  batteryImbalance=(fabsf(batCell1-batCell2)>=BAT_IMBALANCE_LIMIT);

  Serial.printf("[BAT] B1=%.2fV %d%% | B2=%.2fV %d%% | PACK=%.2fV",
                batCell1,bat1Percent,
                batCell2,bat2Percent,
                batPack);

  if(batteryLow)Serial.print(" | LOW");
  if(batteryImbalance)Serial.print(" | IMBALANCE");

  Serial.println();
}

// ================================================================
// ACTUATORS
// ================================================================

void applyDuty(float d){
  duty_f=constrain(d,DUTY_MIN_F,DUTY_MAX_F);
  uint8_t pwm=(uint8_t)(duty_f*(float)PWM_MAX);
  ledcWrite(PIN_PWM,pwm);
}

void disableBuck(){
  ledcWrite(PIN_PWM,0);
  digitalWrite(PIN_SD,LOW);
  mppt_active=false;
}

void enableBuck(){
  digitalWrite(PIN_SD,HIGH);
  mppt_active=true;
}

void setSW1(bool on){
  digitalWrite(PIN_SW1,on?HIGH:LOW);
}

void setSW2(bool on){
  digitalWrite(PIN_SW2,on?HIGH:LOW);
}

void setRelay(bool on){
  digitalWrite(PIN_RELAY,on?HIGH:LOW);
}

// ================================================================
// FAULT HANDLING
// ================================================================

void enterFault(uint16_t code,const char* msg){
  if(fault_latched)return;

  disableBuck();
  applyDuty(DUTY_MIN_F);

  setSW1(false);
  setSW2(false);
  setRelay(false);

  mode=MODE_FAULT;
  fault_latched=true;
  fault_code=code;

  strncpy(fault_reason,msg,sizeof(fault_reason)-1);
  fault_reason[sizeof(fault_reason)-1]='\0';

  Serial.printf("\n!!! FAULT %04d: %s\n",code,msg);

  lcd.clear();
  lcd.setCursor(0,0);
  lcd.print("FAULT");
  lcd.setCursor(0,1);
  lcd.print(msg);
}

void resetFault(){
  if(!fault_latched)return;

  fault_latched=false;
  fault_code=0;
  fault_reason[0]='\0';

  mode=MODE_NORMAL;
  prevMode=MODE_NORMAL;

  transState=TRANS_IDLE;
  transitionSampleCount=0;
  transitionSampleDone=false;

  sensor_err_cnt=0;
  pv_ocp_cnt=0;
  ssActive=false;
  load_ocp=false;

  duty_f=DUTY_MIN_F;
  Vprev=0;
  Iprev=0;

  ina1Ok=inaInit(ina1);
  ina2Ok=inaInit(ina2);

  Serial.println("\n*** FAULT RESET ***");

  lcd.clear();
  lcd.setCursor(0,0);
  lcd.print("Reset OK");
  lcd.setCursor(0,1);
  lcd.print("Restarting...");

  delay(500);
}

